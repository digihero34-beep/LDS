# Database URL (Neon Lakebase PostgreSQL connection string)
DATABASE_URL="postgresql://neondb_owner:<PASSWORD>@<ENDPOINT>.neon.tech/neondb?sslmode=require"

# LLM Evaluator API Configuration (Groq or Gemini)
# Groq (recommended):
LLM_API_KEY="gsk_..."
LLM_PROVIDER="Groq"
LLM_MODEL="qwen/qwen3.8-27b"

# Google Gemini (alternative):
# LLM_API_KEY="AIza..."
# LLM_PROVIDER="gemini"
# LLM_MODEL="gemini-2.5-flash"
